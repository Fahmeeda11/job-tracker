# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
# Every variable here is validated by apps/api/src/lib/env.ts at boot.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Datastores (match docker-compose.yml) ---
MONGO_URI=mongodb://localhost:27017/job-tracker
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Web origin, for CORS + cookie scope ---
WEB_ORIGIN=http://localhost:5173

# --- Email ---
# "ethereal" auto-creates a throwaway test inbox at boot and prints a preview
# URL for every message sent. No credentials needed for local development.
# Switch to "smtp" (and fill SMTP_*) or "resend" (and fill RESEND_API_KEY) in prod.
MAIL_TRANSPORT=ethereal
MAIL_FROM="Job Tracker <noreply@job-tracker.local>"

# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# RESEND_API_KEY=
